<Page x:Class="SportClub.Account"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SportClub"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="450"
      Title="Account">

    <Grid>
        <!--граница окна-->
        <Border BorderThickness="3" BorderBrush="Black"/>

        <StackPanel>
            <!--сверху блок название-->
            <TextBlock Margin="4 4 4 0" Text="SPORTCLUB" Foreground="White" FontWeight="Bold" TextAlignment="Center" 
                FontSize="65" VerticalAlignment="Top" Background="#565163"/>

            <Button Content="Назад" Margin="0 7 10 0" Width="60" HorizontalAlignment="Right"
                FontSize="16"/>
            <TextBlock Text="*Username*" FontSize="50" HorizontalAlignment="Center"/>

            <GroupBox Margin="0 0 0 0" Height="300" Width="400">
                <StackPanel>
                    <TextBlock Text="Почта:" Margin="40 30 0 0" Width="75" HorizontalAlignment="Left" FontSize="20"/>
                    <TextBlock Text="email" Margin="40 0 40 0" FontSize="16"/>

                    <TextBlock Text="Телефон:" Margin="40 30 0 0" Width="85" HorizontalAlignment="Left" FontSize="20"/>
                    <TextBlock Text="phone number" Margin="40 0 40 0" FontSize="16"/>

                    <TextBlock Text="Дата рождения:" Margin="40 30 0 0" Width="150" HorizontalAlignment="Left" FontSize="20"/>
                    <TextBlock Text="01.01.1970" Margin="40 0 40 0" FontSize="16"/>

                    <Button Content="Выход" Margin="0 15 40 0" Width="75" HorizontalAlignment="Right" FontSize="16"/>
                </StackPanel>
            </GroupBox>
            <Button Content="Редактировать" Margin="27 10 0 0" HorizontalAlignment="Left" Width="120" 
                FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>
