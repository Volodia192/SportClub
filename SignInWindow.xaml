<Window x:Class="SportClub.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportClub"
        mc:Ignorable="d"
        Title="SignIn" Height="600" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!--граница окна-->
        <Border BorderThickness="3" BorderBrush="Black"/>
        <!--сверху блок название-->
        <TextBlock Margin="4 4 4 0" Text="SPORTCLUB" Foreground="White" FontWeight="Bold" TextAlignment="Center" 
                   FontSize="65" VerticalAlignment="Top" Background="#565163"/>

        <!--окошко входа-->
        <GroupBox Margin="0 50 0 0" Header="Вход" FontSize="55" Height="400" Width="400">
            <StackPanel>
                <!--логин-->
                <TextBlock Margin="40 45 40 0" Text="Логин" FontSize="25"/>
                <TextBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                <!--пароль-->
                <TextBlock Margin="40 20 40 0" Text="Пароль" FontSize="25"/>
                <PasswordBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                <Button Margin="60 40 60 0" Content="Войти" FontSize="30" Width="100" Click="OpenMainWindow"/>
            </StackPanel>
        </GroupBox>
        <!--Переход в окно регистрации-->
        <TextBlock VerticalAlignment="Bottom" Margin="100 0 100 36" Width="95" Text="Регистрация" 
                   TextAlignment="Center" 
                   FontSize="16" Cursor="Hand"
                   MouseLeftButtonUp="OpenSignUpWindow"/>
    </Grid>
</Window>