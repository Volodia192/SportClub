<Page x:Class="SportClub.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SportClub"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="450"
      Title="SportClub">
    <Grid>
        <!--граница окна-->
        <Border BorderThickness="3" BorderBrush="Black"/>

        <StackPanel>
            <!--сверху блок название-->
            <TextBlock Margin="4 4 4 0" Text="SPORTCLUB" Foreground="White" FontWeight="Bold" TextAlignment="Center" 
                FontSize="65" VerticalAlignment="Top" Background="#565163"/>

            <Button Content="Username" Margin="0 7 10 0" Width="100" HorizontalAlignment="Right"
                    FontSize="16"/>
            <TextBlock Text="Расчёт стоимости" FontSize="50" HorizontalAlignment="Center"/>
            <Border Height="2" Background="Black" Margin="20 0 20 0"/>

            <GroupBox Margin="0 20 0 0" Height="300" Width="400">
                <ScrollViewer>
                    <StackPanel>
                        <TextBlock Text="Тариф" Margin="25 25 0 0" HorizontalAlignment="Left" FontSize="20"/>
                        <ComboBox Margin="25 0 25 0">
                            <!--Хуйня 1
                            Хуйня 2-->
                        </ComboBox>
                        <TextBlock Margin="25"><!--Какая-то инфа тут по пунктам--></TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
            <Button Content="Далее" Margin="0 10 27 0" HorizontalAlignment="Right" Width="50" 
                    FontSize="16"/>
        </StackPanel>
    </Grid>
</Page>
