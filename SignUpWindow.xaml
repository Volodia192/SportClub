<Window x:Class="SportClub.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportClub"
        mc:Ignorable="d"
        Title="SignUp" Height="600" Width="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!--граница окна-->
        <Border BorderThickness="3" BorderBrush="Black"/>
        <!--сверху блок название-->
        <TextBlock Margin="4 4 4 0" Text="SPORTCLUB" TextAlignment="Center"  
           FontSize="65" VerticalAlignment="Top" Background="#565163"/>
        <GroupBox Margin="0 50 0 0" Header="Регистрация" FontSize="55" Height="400" Width="400">
            <ScrollViewer>
                <StackPanel>
                    <!--логин-->
                    <TextBlock Margin="40 45 40 0" Text="Логин" FontSize="25"/>
                    <TextBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                    <!--почта-->
                    <TextBlock Margin="40 20 40 0" Text="Почта" FontSize="25"/>
                    <TextBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                    <!--телефон-->
                    <TextBlock Margin="40 20 40 0" Text="Телефон" FontSize="25"/>
                    <TextBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                    <!--дата рождения-->
                    <TextBlock Margin="40 20 40 0" Text="Дата рождения" FontSize="25"/>
                    <DatePicker Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1"/>

                    <!--пароль-->
                    <TextBlock Margin="40 20 40 0" Text="Пароль" FontSize="25"/>
                    <PasswordBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                    <!--проверка пароля-->
                    <TextBlock Margin="40 20 40 0" Text="Повторите пароль" FontSize="25"/>
                    <PasswordBox Margin="40 0 40 0" FontSize="20" VerticalContentAlignment="Center" Height="40" BorderThickness="1" />

                    <Button Margin="0 40 0 0" Content="Зарегистрироваться" VerticalAlignment="Center" FontSize="30" Width="300"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
        <!--переход в окно входа-->
        <TextBlock VerticalAlignment="Bottom" Margin="100 0 100 36" Width="40" Text="Вход" 
                   TextAlignment="Center" FontSize="16" Cursor="Hand"
                   MouseLeftButtonUp="OpenSignInWindow"/>
    </Grid>
</Window>